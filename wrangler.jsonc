{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aero-works-website",
  "compatibility_date": "2026-10-11",
  "main": "./src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "secrets": {
    "required": ["RESEND_API_KEY"]
  }
}